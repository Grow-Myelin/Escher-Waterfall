{
  "name": "escher-waterfall",
  "version": "1.0.0",
  "private": true,
  "description": "An animated, true-isometric 3D reconstruction of M. C. Escher's lithograph Waterfall (1961).",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --minify --target=es2020 --outfile=dist/waterfall.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/waterfall.js --sourcemap --watch",
    "start": "npm run build && npx --yes http-server -c-1 -p 8080 ."
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
